# Copy to .env and fill in. .env is gitignored.

# ── Gmail SMTP (daily close newsletter) ──────────────────────────────────────
# GMAIL_APP_PASSWORD must be a 16-character Google App Password, NOT your
# account password. Requires 2-Step Verification enabled on the account:
#   https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
NEWSLETTER_TO=you@gmail.com

# ── Gemini (one-line "why it moved" summaries; optional) ─────────────────────
# Without this the newsletter still sends, showing headlines only.
GEMINI_API_KEY=

# ── Unused legacy key ────────────────────────────────────────────────────────
# FMP_API_KEY=
